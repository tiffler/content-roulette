{
  // Tailwind IntelliSense is ON — this project uses Tailwind, with Open Props
  // supplying the values behind the theme scales (see tailwind.config.js).
  // Autocomplete will show e.g. p-5 -> var(--size-4).
  "tailwindCSS.validate": true,
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.includeLanguages": {
    "javascript": "javascript",
    "javascriptreact": "javascriptreact"
  },
  // Suggest classes inside clsx()/cn()-style helpers and template literals too.
  "tailwindCSS.experimental.classRegex": [
    ["(?:clsx|cn|classNames)\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"]
  ],

  // node_modules is a symlink to node_modules.nosync, which keeps ~12k dependency
  // files out of iCloud sync (syncing them starves file I/O and wedges vite).
  // Keep the editor from watching or indexing through either path — this is also
  // what stops IntelliSense stalling on "Analyzing <file>..." in this project.
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/node_modules.nosync/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/node_modules.nosync": true,
    "**/dist": true
  },
  "files.exclude": {
    "**/node_modules.nosync": true
  }
}